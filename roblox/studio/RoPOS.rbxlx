		Category = "Snacks",
		Price = 2,
		TaxRate = 20,
		Colour = rgb(255, 170, 200),
		Tool = "Ice Cream Cone",
	},
	-- Gear
	{
		Id = "gravitycoil",
		Name = "Gravity Coil",
		Category = "Gear",
		Price = 25,
		TaxRate = 20,
		Stock = 10,
		Colour = rgb(120, 80, 220),
		Tool = "Gravity Coil",
	},
	{
