# Copy this file to .env and fill in your key. Never share or commit .env.
# Test keys start with sk_test_ and work with simulated readers. Live keys start with sk_live_.
# A restricted key (rk_...) with Terminal, PaymentIntents and Refunds write access is safer than a full secret key.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional
# PORT=3000
# HOST=127.0.0.1
# POS_DATA_DIR=C:\POS-data
