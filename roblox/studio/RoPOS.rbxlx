      <Item class="LocalScript" referent="34">
        <Properties>
          <string name="Name">POSClient</string>
          <string name="Source"><![CDATA[-- RoPOS client bootstrap.

local CollectionService = game:GetService("CollectionService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Roles = require(Shared.Roles)

local Api = require(script.Api)
local App = require(script.App)
local PaymentPrompt = require(script.PaymentPrompt)
local State = require(script.State)
local Toasts = require(script.UI.Toasts)

local hello
for attempt = 1, 5 do
	local ok, data = Api.call("session.hello")
	if ok then
		hello = data
		break
	end
	task.wait(attempt)
end
if not hello then
	warn("[RoPOS] Could not reach the server")
	return
end

State.role = hello.role
State.roleName = hello.roleName
State.maxDiscount = hello.maxDiscount
State.persistent = hello.persistent
State.set("catalogue", hello.catalogue or {})
State.register = hello.register

App.mount()
PaymentPrompt.mount(App.overlay() :: any)

Api.on("OpenRegister", function(summary)
	State.set("register", summary)
	App.open()
end)

Api.on("CloseRegister", function(payload)
	State.set("register", nil)
	App.close()
	if payload and payload.reason then
		Toasts.show(payload.reason, "info")
	end
end)

Api.on("Register", function(summary)
	State.set("register", summary)
end)

Api.on("Catalogue", function(list)
	State.set("catalogue", list)
end)

Api.on("Toast", function(toast)
	Toasts.show(toast.text, toast.kind)
end)

-- Customers never see the "Use register" prompt. This only changes the local copy.
if State.role < Roles.Cashier then
	local function hide(instance: Instance)
		for _, descendant in instance:GetDescendants() do
			if descendant:IsA("ProximityPrompt") and descendant.Name == "RoPOSPrompt" then
				descendant.Enabled = false
			end
		end
		instance.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("ProximityPrompt") and descendant.Name == "RoPOSPrompt" then
				descendant.Enabled = false
			end
		end)
	end
	for _, register in CollectionService:GetTagged(Config.RegisterTag) do
		hide(register)
	end
	CollectionService:GetInstanceAddedSignal(Config.RegisterTag):Connect(hide)
end

if hello.register then
	App.open()
end
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Api</string>
            <string name="Source"><![CDATA[-- Client side of the Api router: Api.call returns (ok, dataOrError), Api.on listens to pushes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("POS")
local Net = require(Shared:WaitForChild("Net"))

local Api = {}

local remote, push = Net.client()
local listeners: { [string]: { (any) -> () } } = {}

push.OnClientEvent:Connect(function(kind: string, payload: any)
	local list = listeners[kind]
	if list then
		for _, fn in list do
			task.spawn(fn, payload)
		end
	end
end)

function Api.on(kind: string, fn: (any) -> ())
	listeners[kind] = listeners[kind] or {}
	table.insert(listeners[kind], fn)
end

function Api.call(action: string, ...: any): (boolean, any)
	local ok, response = pcall(remote.InvokeServer, remote, action, ...)
	if not ok then
		return false, "Connection problem. Try again."
	end
	if typeof(response) ~= "table" then
		return false, "Unexpected response"
	end
	if response.ok then
		return true, response.data
	end
	return false, response.error
end

return Api
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">App</string>
            <string name="Source"><![CDATA[-- The staff window: header, tabs and screens. Opens when a cashier uses a register.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Roles = require(Shared.Roles)

local Api = require(script.Parent.Api)
local State = require(script.Parent.State)
local UI = require(script.Parent.UI.UI)
local Theme = require(script.Parent.UI.Theme)
local Toasts = require(script.Parent.UI.Toasts)

local Screens = script.Parent.Screens

local C, F = Theme.Colors, Theme.Fonts

local App = {}

type Screen = { frame: GuiObject, show: (() -> ())? }

local TABS = {
	{ id = "sell", label = "Sell", icon = "🛒", role = Roles.Cashier, module = "Sell" },
	{ id = "sales", label = "Sales", icon = "🧾", role = Roles.Cashier, module = "Sales" },
	{ id = "shift", label = "Shift", icon = "⏱", role = Roles.Cashier, module = "Shift" },
	{ id = "products", label = "Products", icon = "📦", role = Roles.Manager, module = "Products" },
	{ id = "reports", label = "Reports", icon = "📊", role = Roles.Manager, module = "Reports" },
	{ id = "audit", label = "Audit log", icon = "📜", role = Roles.Manager, module = "Audit" },
}

local gui: ScreenGui
local overlay: Frame -- modals and toasts go here so they scale with the window
local window: CanvasGroup
local windowScale: UIScale
local content: Frame
local tabBar: Frame
local shiftPill: Frame
local registerLabel: TextLabel
local screens: { [string]: Screen } = {}
local tabButtons: { [string]: TextButton } = {}
local active: string? = nil
local isOpen = false

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

function App.go(id: string)
	if not screens[id] then
		return
	end
	active = id
	for tabId, screen in screens do
		screen.frame.Visible = tabId == id
	end
	for tabId, button in tabButtons do
		local selected = tabId == id
		UI.tween(button, {
			BackgroundColor3 = if selected then C.AccentSoft else C.Panel,
			TextColor3 = if selected then C.Text else C.Muted,
		})
	end
	local screen = screens[id]
	if screen.show then
		task.spawn(screen.show)
	end
end

local function updateHeader()
	local register = State.register
	registerLabel.Text = if register then register.name else ""
	local label = shiftPill:FindFirstChild("Label") :: TextLabel
	if register and register.shift then
		label.Text = "● Shift open · " .. money(register.shift.net)
		label.TextColor3 = C.Success
		shiftPill.BackgroundColor3 = C.SuccessSoft
	else
		label.Text = "○ Shift closed"
		label.TextColor3 = C.Warning
		shiftPill.BackgroundColor3 = C.WarningSoft
	end
end

local function buildTabs()
	UI.clear(tabBar)
	table.clear(tabButtons)
	for _, screen in screens do
		screen.frame:Destroy()
	end
	table.clear(screens)

	local ctx = { overlay = overlay, go = App.go }
	for i, tab in TABS do
		if State.role >= tab.role then
			local screen = require(Screens:FindFirstChild(tab.module)).new(ctx)
			screen.frame.Visible = false
			screen.frame.Parent = content
			screens[tab.id] = screen
			tabButtons[tab.id] = UI.button({
				Text = tab.icon .. "  " .. tab.label,
				Style = "ghost",
				TextSize = 15,
				Size = UDim2.fromScale(0, 1),
				LayoutOrder = i,
				Parent = tabBar,
			})
			local button = tabButtons[tab.id]
			button.AutomaticSize = Enum.AutomaticSize.X
			UI.padding(0, 14).Parent = button
			button.Activated:Connect(function()
				App.go(tab.id)
			end)
		end
	end
end

function App.open()
	if isOpen then
		App.go(active or "sell")
		return
	end
	isOpen = true
	window.Visible = true
	window.GroupTransparency = 1
	windowScale.Scale = 0.94
	UI.tween(window, { GroupTransparency = 0 }, Theme.TweenSlow)
	UI.tween(windowScale, { Scale = 1 }, Theme.TweenSlow)
	App.go(active or "sell")
end

function App.close()
	if not isOpen then
		return
	end
	isOpen = false
	UI.tween(window, { GroupTransparency = 1 })
	UI.tween(windowScale, { Scale = 0.96 })
	task.delay(0.2, function()
		if not isOpen then
			window.Visible = false
		end
	end)
	for _, child in overlay:GetChildren() do
		if child.Name == "Modal" then
			child:Destroy()
		end
	end
end

function App.isOpen(): boolean
	return isOpen
end

function App.overlay(): Frame
	return overlay
end

local function header(): Frame
	local player = Players.LocalPlayer
	shiftPill = UI.pill("", C.Warning, C.WarningSoft, { LayoutOrder = 1 })
	registerLabel = UI.text({
		Text = "",
		TextSize = 14,
		TextColor3 = C.Muted,
		Position = UDim2.fromOffset(52, 28),
		Size = UDim2.new(1, -52, 0, 18),
	})

	local right = UI.new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromScale(0.6, 1),
		Children = {
			UI.list(10, Enum.FillDirection.Horizontal, {
				HorizontalAlignment = Enum.HorizontalAlignment.Right,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			}),
			if not State.persistent
				then UI.pill("Studio: data not saved", C.Warning, C.WarningSoft, { LayoutOrder = 0 })
				else nil,
			shiftPill,
			UI.pill(player.DisplayName .. " · " .. State.roleName, C.Text, C.Raised, { LayoutOrder = 2 }),
			UI.button({
				Name = "Close",
				Text = "✕",
				Style = "ghost",
				TextSize = 18,
				Size = UDim2.fromOffset(40, 40),
				LayoutOrder = 3,
				OnClick = function()
					Api.call("register.leave")
					App.close()
				end,
			}),
		},
	})

	return UI.new("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
		Children = {
			UI.new("TextLabel", {
				Text = string.sub(Config.Store.Name, 1, 1),
				FontFace = F.Heavy,
				TextSize = 22,
				TextColor3 = Color3.new(1, 1, 1),
				BackgroundColor3 = C.Accent,
				Size = UDim2.fromOffset(42, 42),
				Position = UDim2.fromOffset(0, 3),
				Children = {
					UI.corner(Theme.Radius.Medium),
					UI.new("UIGradient", {
						Color = ColorSequence.new(C.AccentHover, Color3.fromRGB(150, 92, 255)),
						Rotation = 45,
					}),
				},
			}),
			UI.text({
				Text = Config.Store.Name,
				TextSize = 20,
				FontFace = F.Heavy,
				Position = UDim2.fromOffset(52, 4),
				Size = UDim2.new(0.4, 0, 0, 24),
			}),
			registerLabel,
			right,
		},
	})
end

-- Lays the window out in "virtual pixels" so it fits any screen, from phones to 4K.
local function fitToScreen(root: Frame, scale: UIScale)
	local camera = workspace.CurrentCamera
	local function update()
		local viewport = camera.ViewportSize
		local s = math.clamp(math.min(viewport.X / 1060, viewport.Y / 640), 0.5, 1.25)
		scale.Scale = s
		root.Size = UDim2.fromOffset(viewport.X / s, viewport.Y / s)
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	update()
end

function App.mount()
	gui = UI.new("ScreenGui", {
		Name = "RoPOS",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local rootScale = UI.new("UIScale")
	local root = UI.new("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = gui,
		Children = { rootScale },
	})
	fitToScreen(root, rootScale)

	windowScale = UI.new("UIScale")
	window = UI.new("CanvasGroup", {
		Name = "Window",
		Visible = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(1, -40, 1, -40),
		BackgroundColor3 = C.Bg,
		Parent = root,
		Children = {
			UI.corner(Theme.Radius.Large),
			UI.stroke(C.Border),
			UI.new("UISizeConstraint", { MaxSize = Vector2.new(1280, 780) }),
			windowScale,
			UI.padding(16, 20),
		},
	})
	header().Parent = window

	tabBar = UI.new("Frame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 60),
		Size = UDim2.new(1, 0, 0, 38),
		Parent = window,
		Children = { UI.list(6, Enum.FillDirection.Horizontal) },
	})
	UI.new("Frame", {
		Name = "Divider",
		BackgroundColor3 = C.Border,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 106),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = window,
	})
	content = UI.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, 120),
		Size = UDim2.new(1, 0, 1, -120),
		Parent = window,
	})

	overlay = UI.new("Frame", {
		Name = "Overlay",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 20,
		Parent = root,
	})
	Toasts.mount(overlay :: any)

	buildTabs()
	updateHeader()

	State.changed:Connect(function(key)
		if key == "register" then
			updateHeader()
		elseif key == "role" then
			buildTabs()
			if isOpen then
				App.go("sell")
			end
		end
	end)

	-- Escape closes the window on keyboards.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and isOpen and input.KeyCode == Enum.KeyCode.Escape then
			Api.call("register.leave")
			App.close()
		end
	end)
end

return App
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">PaymentPrompt</string>
            <string name="Source"><![CDATA[-- The customer's side of checkout: an itemised bill with a countdown, Pay and Decline.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Api = require(script.Parent.Api)
local Receipt = require(script.Parent.Receipt)
local UI = require(script.Parent.UI.UI)
local Theme = require(script.Parent.UI.Theme)
local Toasts = require(script.Parent.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local PaymentPrompt = {}

local gui: ScreenGui
local current: { id: string, close: () -> () }? = nil

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

local function balance(): number?
	local leaderstats = Players.LocalPlayer:FindFirstChild("leaderstats")
	local stat = leaderstats and leaderstats:FindFirstChild(Config.Currency.StatName)
	return if stat and (stat:IsA("IntValue") or stat:IsA("NumberValue")) then stat.Value else nil
end

local function totalRow(label: string, value: string, order: number, strong: boolean?)
	return UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, if strong then 34 else 22),
		LayoutOrder = order,
		Children = {
			UI.text({
				Text = label,
				TextSize = if strong then 20 else 15,
				FontFace = if strong then F.Heavy else F.Medium,
				TextColor3 = if strong then C.Text else C.Muted,
				Size = UDim2.fromScale(0.5, 1),
			}),
			UI.text({
				Text = value,
				TextSize = if strong then 26 else 15,
				FontFace = if strong then F.Heavy else F.Medium,
				TextColor3 = if strong then C.Text else C.Muted,
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.fromScale(0.5, 0),
				Size = UDim2.fromScale(0.5, 1),
			}),
		},
	})
end

function PaymentPrompt.show(order)
	if current then
		current.close()
	end

	local dialog, close = UI.modal(gui, { Width = 420, Dismissable = false })
	local entry = { id = order.id, close = close }
	current = entry
	local function done()
		if current == entry then
			current = nil
		end
		close()
	end

	-- Header
	UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 52),
		LayoutOrder = 1,
		Parent = dialog,
		Children = {
			UI.new("TextLabel", {
				Text = "🛒",
				TextSize = 24,
				BackgroundColor3 = C.AccentSoft,
				Size = UDim2.fromOffset(48, 48),
				Children = { UI.corner(Theme.Radius.Medium) },
			}),
			UI.text({
				Text = "Payment request",
				TextSize = 22,
				FontFace = F.Heavy,
				Position = UDim2.fromOffset(60, 2),
				Size = UDim2.new(1, -60, 0, 26),
			}),
			UI.text({
				Text = string.format("%s at %s, %s", order.cashier, order.registerName, Config.Store.Name),
				TextSize = 14,
				TextColor3 = C.Muted,
				Position = UDim2.fromOffset(60, 28),
				Size = UDim2.new(1, -60, 0, 20),
			}),
		},
	})

	-- Items
	local list = UI.scroll({
		Name = "Items",
		Size = UDim2.new(1, 0, 0, math.min(#order.lines * 30 + 12, 190)),
		BackgroundColor3 = C.Raised,
		BackgroundTransparency = 0,
		LayoutOrder = 2,
		Parent = dialog,
		Children = { UI.corner(Theme.Radius.Medium), UI.padding(6, 12), UI.list(0) },
	})
	for i, line in order.lines do
		UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = i,
			Parent = list,
			Children = {
				UI.text({
					Text = string.format("%d × %s", line.qty, line.name or line.productId),
					Size = UDim2.new(1, -90, 1, 0),
					TextSize = 15,
				}),
				UI.text({
					Text = money(line.unitPrice * line.qty),
					TextXAlignment = Enum.TextXAlignment.Right,
					Position = UDim2.new(1, -90, 0, 0),
					Size = UDim2.new(0, 90, 1, 0),
					TextSize = 15,
					FontFace = F.Mono,
				}),
			},
		})
	end

	-- Totals
	local totals = UI.new("Frame", {
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.fromScale(1, 0),
		LayoutOrder = 3,
		Parent = dialog,
		Children = { UI.list(2) },
	})
	if order.discount > 0 or order.tax > 0 then
		totalRow("Subtotal", money(order.subtotal), 1).Parent = totals
	end
	if order.discount > 0 then
		totalRow(string.format("Discount (%d%%)", order.discountPct), "-" .. money(order.discount), 2).Parent = totals
	end
	if order.tax > 0 then
		totalRow(Config.Tax.Name, money(order.tax), 3).Parent = totals
	end
	totalRow("Total", money(order.total), 4, true).Parent = totals

	local wallet = balance()
	local enough = wallet ~= nil and wallet >= order.total
	UI.text({
		Text = if wallet
			then string.format(
				"Your %s: %s → %s",
				Config.Currency.StatName,
				money(wallet),
				money(wallet - order.total)
			)
			else "Loading your balance…",
		TextSize = 14,
		TextColor3 = if enough then C.Muted else C.Danger,
		LayoutOrder = 4,
		Parent = dialog,
	})

	-- Countdown
	local bar = UI.new("Frame", {
		BackgroundColor3 = C.Accent,
		Size = UDim2.fromScale(1, 1),
		Children = { UI.corner(Theme.Radius.Pill) },
	})
	UI.new("Frame", {
		BackgroundColor3 = C.Raised,
		Size = UDim2.new(1, 0, 0, 6),
		LayoutOrder = 5,
		Parent = dialog,
		Children = { UI.corner(Theme.Radius.Pill), bar },
	})
	UI.tween(
		bar,
		{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Warning },
		TweenInfo.new(order.timeout, Enum.EasingStyle.Linear)
	)

	-- Actions
	local actions = UI.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = 6,
		Parent = dialog,
	})
	local decline = UI.button({
		Text = "Decline",
		Style = "ghost",
		Size = UDim2.new(0.38, -5, 1, 0),
		OnClick = function(button)
			UI.setEnabled(button, false)
			Api.call("checkout.respond", order.id, false)
			done()
		end,
	})
	decline.Parent = actions
	local pay = UI.button({
		Text = if enough then "Pay " .. money(order.total) else "Not enough " .. Config.Currency.StatName,
		Style = "success",
		TextSize = 18,
		Position = UDim2.new(0.38, 5, 0, 0),
		Size = UDim2.new(0.62, -5, 1, 0),
		OnClick = function(button)
			UI.setEnabled(button, false)
			UI.setEnabled(decline, false)
			button.Text = "Paying…"
			local ok, result = Api.call("checkout.respond", order.id, true)
			if ok then
				done()
			else
				Toasts.show(result, "error")
				button.Text = "Pay " .. money(order.total)
				UI.setEnabled(button, true)
				UI.setEnabled(decline, true)
			end
		end,
	})
	pay.Parent = actions
	if not enough then
		UI.setEnabled(pay, false)
	end
end

function PaymentPrompt.mount(screen: ScreenGui)
	gui = screen
	Api.on("PaymentRequest", PaymentPrompt.show)
	Api.on("PaymentClosed", function(payload)
		if current and current.id == payload.orderId then
			current.close()
			current = nil
			if payload.reason then
				Toasts.show(payload.reason, "warning")
			end
		end
	end)
	Api.on("Receipt", function(sale)
		Toasts.show(string.format("Paid %s. Enjoy!", money(sale.total)), "success")
		-- When you rang yourself up, the Sell screen already shows this receipt.
		if sale.cashier.userId ~= Players.LocalPlayer.UserId then
			Receipt.showSale(gui, sale)
		end
	end)
end

return PaymentPrompt
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Receipt</string>
            <string name="Source"><![CDATA[-- Paper-style receipts and shift reports, with the manager refund flow.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Api = require(script.Parent.Api)
local UI = require(script.Parent.UI.UI)
local Theme = require(script.Parent.UI.Theme)
local Toasts = require(script.Parent.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Receipt = {}

local WIDTH = 34 -- characters per receipt line
local LINE_HEIGHT = 18

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

type Line = { text: string, align: string?, bold: boolean? }

local function paper(lines: { Line }, stamp: string?): Frame
	local scroll = UI.scroll({
		Name = "Paper",
		Size = UDim2.new(1, 0, 0, math.min(#lines * LINE_HEIGHT + 40, 420)),
		BackgroundColor3 = C.Paper,
		BackgroundTransparency = 0,
		ScrollBarImageColor3 = Color3.fromRGB(190, 186, 176),
		Children = { UI.corner(6), UI.padding(20, 18), UI.list(0) },
	})
	for i, line in lines do
		UI.text({
			Text = line.text,
			LayoutOrder = i,
			FontFace = if line.bold then F.MonoBold else F.Mono,
			TextSize = 14,
			TextColor3 = C.Ink,
			TextTruncate = Enum.TextTruncate.None,
			TextXAlignment = if line.align == "center" then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
			Size = UDim2.new(1, 0, 0, LINE_HEIGHT),
			Parent = scroll,
		})
	end
	local holder = UI.new("Frame", {
		Name = "PaperHolder",
		BackgroundTransparency = 1,
		Size = scroll.Size,
		LayoutOrder = 1,
		Children = { scroll },
	})
	if stamp then
		UI.text({
			Text = stamp,
			FontFace = F.Heavy,
			TextSize = 40,
			TextColor3 = C.Danger,
			TextTransparency = 0.15,
			TextXAlignment = Enum.TextXAlignment.Center,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.fromOffset(260, 56),
			Rotation = -14,
			ZIndex = 5,
			Children = { UI.stroke(C.Danger, 3, 0.15) },
			Parent = holder,
		})
	end
	return holder
end

local function rule(): Line
	return { text = string.rep("-", WIDTH) }
end

local function row(left: string, right: string, bold: boolean?): Line
	return { text = Format.row(left, right, WIDTH), bold = bold }
end

function Receipt.saleLines(sale): { Line }
	local lines: { Line } = {
		{ text = string.upper(Config.Store.Name), align = "center", bold = true },
		{ text = sale.registerName, align = "center" },
		rule(),
		row("Receipt", sale.receipt),
		row("Date", Format.dateTime(sale.t)),
		row("Cashier", sale.cashier.name),
		row("Customer", sale.customer.name),
		rule(),
	}
	for _, line in sale.lines do
		table.insert(lines, row(string.format("%d x %s", line.qty, line.name), money(line.unitPrice * line.qty)))
	end
	table.insert(lines, rule())
	table.insert(lines, row("Subtotal", money(sale.subtotal)))
	if sale.discount > 0 then
		table.insert(lines, row(string.format("Discount %d%%", sale.discountPct), "-" .. money(sale.discount)))
	end
	if sale.tax > 0 then
		table.insert(lines, row(Config.Tax.Name .. (if Config.Tax.Inclusive then " (incl.)" else ""), money(sale.tax)))
	end
	table.insert(lines, row("TOTAL", money(sale.total), true))
	if sale.refunded then
		table.insert(lines, rule())
		table.insert(lines, row("Refunded", Format.dateTime(sale.refunded.t)))
		table.insert(lines, row("By", sale.refunded.by))
	end
	table.insert(lines, rule())
	table.insert(lines, { text = Config.Store.Footer, align = "center" })
	return lines
end

local function buttonRow(order: number): Frame
	return UI.new("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = order,
		Children = {
			UI.list(10, Enum.FillDirection.Horizontal, { HorizontalAlignment = Enum.HorizontalAlignment.Right }),
		},
	})
end

-- options.canRefund: show the refund flow. options.onChanged(sale): called after a refund.
function Receipt.showSale(gui: Instance, sale, options: { canRefund: boolean?, onChanged: ((any) -> ())? }?)
	local opts = options or {}
	local dialog, close = UI.modal(gui, { Title = "Receipt " .. sale.receipt, Width = 400 })
	paper(Receipt.saleLines(sale), if sale.refunded then "REFUNDED" else nil).Parent = dialog

	local actions = buttonRow(2)
	actions.Parent = dialog

	local function showActions()
		UI.clear(actions)
		if opts.canRefund and not sale.refunded then
			UI.button({
				Text = "Refund",
				Style = "danger",
				LayoutOrder = 1,
				Parent = actions,
				OnClick = function()
					UI.clear(actions)
					local restock = true
					local toggle
					toggle = UI.button({
						Text = "☑ Restock items",
						Style = "ghost",
						Size = UDim2.fromOffset(150, 40),
						LayoutOrder = 1,
						OnClick = function()
							restock = not restock
							toggle.Text = (if restock then "☑" else "☐") .. " Restock items"
						end,
					})
					toggle.Parent = actions
					UI.button({ Text = "Back", LayoutOrder = 2, Size = UDim2.fromOffset(80, 40), OnClick = showActions }).Parent =
						actions
					UI.button({
						Text = "Confirm " .. money(sale.total),
						Style = "danger",
						Size = UDim2.fromOffset(150, 40),
						LayoutOrder = 3,
						OnClick = function(button)
							UI.setEnabled(button, false)
							button.Text = "Refunding…"
							local ok, result = Api.call("sales.refund", sale.receipt, restock)
							if ok then
								Toasts.show(
									string.format("Refunded %s to %s", money(sale.total), sale.customer.name),
									"success"
								)
								close()
								if opts.onChanged then
									opts.onChanged(result)
								end
							else
								Toasts.show(result, "error")
								showActions()
							end
						end,
					}).Parent =
						actions
				end,
			}).Parent =
				actions
		end
		UI.button({ Text = "Close", Style = "primary", LayoutOrder = 9, OnClick = close }).Parent = actions
	end
	showActions()
	return close
end

function Receipt.showReport(gui: Instance, title: string, report)
	local t = report.totals
	local lines: { Line } = {
		{ text = string.upper(Config.Store.Name), align = "center", bold = true },
		{ text = title, align = "center", bold = true },
		rule(),
		row("Register", report.registerName),
		row("Shift", report.id),
		row("Opened", Format.dateTime(report.openedAt)),
		row("Opened by", report.openedBy),
	}
	if report.closedAt then
		table.insert(lines, row("Closed", Format.dateTime(report.closedAt)))
		table.insert(lines, row("Closed by", report.closedBy))
		table.insert(lines, row("Length", Format.duration(report.closedAt - report.openedAt)))
	end
	table.insert(lines, rule())
	table.insert(lines, row("Sales", tostring(t.count)))
	table.insert(lines, row("Items sold", tostring(t.items)))
	table.insert(lines, row("Gross", money(t.gross)))
	table.insert(lines, row("Discounts", "-" .. money(t.discounts)))
	if t.tax > 0 then
		table.insert(lines, row(Config.Tax.Name, money(t.tax)))
	end
	table.insert(lines, row("Taken", money(t.sales)))
	table.insert(lines, row(string.format("Refunds (%d)", t.refundCount), "-" .. money(t.refunds)))
	table.insert(lines, row("NET", money(report.net), true))
	table.insert(lines, row("Average sale", money(report.average)))
	if #report.topProducts > 0 then
		table.insert(lines, rule())
		table.insert(lines, { text = "TOP ITEMS", bold = true })
		for _, item in report.topProducts do
			table.insert(lines, row(string.format("%d x %s", item.qty, item.name), money(item.total)))
		end
	end
	if #report.cashiers > 0 then
		table.insert(lines, rule())
		table.insert(lines, { text = "BY CASHIER", bold = true })
		for _, cashier in report.cashiers do
			table.insert(lines, row(string.format("%s (%d)", cashier.name, cashier.count), money(cashier.total)))
		end
	end

	local dialog, close = UI.modal(gui, { Title = title, Width = 400 })
	paper(lines).Parent = dialog
	local actions = buttonRow(2)
	actions.Parent = dialog
	UI.button({ Text = "Done", Style = "primary", OnClick = close }).Parent = actions
	return close
end

return Receipt
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">Screens</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Audit</string>
              <string name="Source"><![CDATA[-- Audit log (managers): sign-offs on sales, discounts, refunds, price, stock and shift changes.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local Api = require(Client.Api)
local UI = require(Client.UI.UI)
local Theme = require(Client.UI.Theme)
local Toasts = require(Client.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Audit = {}

local TAGS = {
	sale = { C.Success, C.SuccessSoft },
	refund = { C.Danger, C.DangerSoft },
	discount = { C.Warning, C.WarningSoft },
	["shift.open"] = { C.Accent, C.AccentSoft },
	["shift.close"] = { C.Accent, C.AccentSoft },
}

function Audit.new(_ctx)
	local self = {}
	local frame = UI.new("Frame", { Name = "Audit", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.frame = frame

	UI.text({ Text = "Audit log", TextSize = 24, FontFace = F.Heavy, Size = UDim2.new(0.5, 0, 0, 30), Parent = frame })
	UI.text({
		Text = "The latest 500 actions across every server",
		TextSize = 14,
		TextColor3 = C.Muted,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(0.6, 0, 0, 18),
		Parent = frame,
	})
	local list = UI.scroll({
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		Parent = frame,
		Children = { UI.list(4) },
	})

	function self.show()
		local ok, entries = Api.call("audit.recent", 200)
		UI.clear(list)
		if not ok then
			Toasts.show(entries, "error")
			return
		end
		if #entries == 0 then
			UI.text({ Text = "Nothing logged yet", TextColor3 = C.Faint, Parent = list })
		end
		for i, entry in entries do
			local colours = TAGS[entry.action] or { C.Muted, C.Panel }
			local tag = UI.pill(entry.action, colours[1], colours[2], { Position = UDim2.new(0.22, 0, 0.5, -12) })
			UI.new("Frame", {
				BackgroundColor3 = C.Raised,
				Size = UDim2.new(1, -8, 0, 42),
				LayoutOrder = i,
				Parent = list,
				Children = {
					UI.corner(Theme.Radius.Small),
					UI.text({
						Text = Format.dateTime(entry.t),
						TextSize = 14,
						FontFace = F.Mono,
						TextColor3 = C.Muted,
						Position = UDim2.fromOffset(12, 0),
						Size = UDim2.fromScale(0.12, 1),
					}),
					UI.text({
						Text = entry.actor,
						TextSize = 14,
						FontFace = F.Bold,
						Position = UDim2.fromScale(0.13, 0),
						Size = UDim2.new(0.09, -8, 1, 0),
					}),
					tag,
					UI.text({
						Text = entry.detail,
						TextSize = 14,
						Position = UDim2.fromScale(0.36, 0),
						Size = UDim2.new(0.64, -12, 1, 0),
					}),
				},
			})
		end
	end

	return self
end

return Audit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Products</string>
              <string name="Source"><![CDATA[-- Products (managers): prices, stock adjustments and on/off sale. Changes reach every server.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local Api = require(Client.Api)
local State = require(Client.State)
local UI = require(Client.UI.UI)
local Theme = require(Client.UI.Theme)
local Toasts = require(Client.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Products = {}

local function call(action: string, ...: any)
	local ok, err = Api.call(action, ...)
	if not ok then
		Toasts.show(err, "error")
	end
	return ok
end

function Products.new(_ctx)
	local self = {}
	local frame = UI.new("Frame", { Name = "Products", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.frame = frame

	UI.text({ Text = "Products", TextSize = 24, FontFace = F.Heavy, Size = UDim2.new(0.5, 0, 0, 30), Parent = frame })
	UI.text({
		Text = "Names, categories and tools live in Config.Products. Price, stock and availability are saved here.",
		TextSize = 14,
		TextColor3 = C.Muted,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 18),
		Parent = frame,
	})

	local list = UI.scroll({
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 1, -62),
		Parent = frame,
		Children = { UI.list(6) },
	})

	local function render()
		UI.clear(list)
		for i, product in State.catalogue do
			local row = UI.new("Frame", {
				Name = product.id,
				BackgroundColor3 = C.Raised,
				BackgroundTransparency = if product.active then 0 else 0.5,
				Size = UDim2.new(1, -8, 0, 60),
				LayoutOrder = i,
				Parent = list,
				Children = {
					UI.corner(Theme.Radius.Medium),
					UI.new("Frame", {
						BackgroundColor3 = product.colour,
						Position = UDim2.new(0, 14, 0.5, -14),
						Size = UDim2.fromOffset(28, 28),
						Children = { UI.corner(8) },
					}),
					UI.text({
						Text = product.name,
						FontFace = F.Bold,
						Position = UDim2.fromOffset(54, 10),
						Size = UDim2.new(0.3, -54, 0, 20),
					}),
					UI.text({
						Text = product.category .. "  ·  " .. product.id,
						TextSize = 13,
						TextColor3 = C.Muted,
						Position = UDim2.fromOffset(54, 30),
						Size = UDim2.new(0.3, -54, 0, 18),
					}),
				},
			})

			-- Price
			UI.text({
				Text = Config.Currency.Symbol,
				TextColor3 = C.Muted,
				Position = UDim2.new(0.3, 0, 0.5, -10),
				Size = UDim2.fromOffset(14, 20),
				Parent = row,
			})
			local price = UI.input({
				Text = tostring(product.price),
				TextXAlignment = Enum.TextXAlignment.Right,
				Position = UDim2.new(0.3, 16, 0.5, -18),
				Size = UDim2.fromOffset(96, 36),
			})
			price.Parent = row
			price.FocusLost:Connect(function()
				local value = tonumber(price.Text)
				if value and value >= 0 and value % 1 == 0 then
					if value ~= product.price and call("products.price", product.id, value) then
						Toasts.show(
							product.name .. " now costs " .. Format.money(value, Config.Currency.Symbol),
							"success"
						)
					end
				else
					Toasts.show("Enter a whole number price", "warning")
					price.Text = tostring(product.price)
				end
			end)

			-- Stock
			local stock = UI.new("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0.52, 0, 0.5, -18),
				Size = UDim2.fromOffset(250, 36),
				Parent = row,
				Children = {
					UI.list(6, Enum.FillDirection.Horizontal, { VerticalAlignment = Enum.VerticalAlignment.Center }),
				},
			})
			if product.stock == nil then
				UI.text({
					Text = "Not stock-tracked",
					TextColor3 = C.Faint,
					TextSize = 14,
					Size = UDim2.fromOffset(200, 36),
					Parent = stock,
				})
			else
				for order, delta in { -10, -1 } do
					UI.button({
						Text = tostring(delta),
						TextSize = 13,
						Size = UDim2.fromOffset(42, 32),
						LayoutOrder = order,
						Parent = stock,
						OnClick = function()
							call("products.stock", product.id, delta)
						end,
					})
				end
				local low = product.stock <= Config.Inventory.LowStockAt
				UI.text({
					Text = tostring(product.stock),
					FontFace = F.Heavy,
					TextSize = 18,
					TextColor3 = if product.stock == 0 then C.Danger elseif low then C.Warning else C.Text,
					TextXAlignment = Enum.TextXAlignment.Center,
					Size = UDim2.fromOffset(52, 32),
					LayoutOrder = 3,
					Parent = stock,
				})
				for order, delta in { 1, 10 } do
					UI.button({
						Text = "+" .. delta,
						TextSize = 13,
						Size = UDim2.fromOffset(42, 32),
						LayoutOrder = 3 + order,
						Parent = stock,
						OnClick = function()
							call("products.stock", product.id, delta)
						end,
					})
				end
			end

			-- On sale toggle
			UI.button({
				Text = if product.active then "On sale" else "Off sale",
				Style = if product.active then "success" else "secondary",
				TextSize = 14,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -14, 0.5, 0),
				Size = UDim2.fromOffset(96, 34),
				Radius = Theme.Radius.Pill,
				Parent = row,
				OnClick = function()
					call("products.active", product.id, not product.active)
				end,
			})
		end
	end

	State.changed:Connect(function(key)
		if key == "catalogue" and frame.Visible then
			-- Do not redraw while someone is typing a price.
			local focused = game:GetService("UserInputService"):GetFocusedTextBox()
			if not (focused and focused:IsDescendantOf(list)) then
				render()
			end
		end
	end)

	self.show = render
	return self
end

return Products
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Reports</string>
              <string name="Source"><![CDATA[-- Reports (managers): 7-day takings chart, totals, best sellers and cashier leaderboard.
-- Days are UTC so every server agrees on where a sale belongs.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Aggregate = require(Shared.Aggregate)
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local Api = require(Client.Api)
local UI = require(Client.UI.UI)
local Theme = require(Client.UI.Theme)
local Toasts = require(Client.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Reports = {}

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

local function rankList(
	parent: Instance,
	title: string,
	rows: { { label: string, value: number, sub: string } },
	colour: Color3,
	order: number
)
	local card = UI.card({
		AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(0.5, -6, 0, 0),
		LayoutOrder = order,
		Parent = parent,
		Children = { UI.padding(16), UI.list(8) },
	})
	UI.text({ Text = title, FontFace = F.Bold, Parent = card })
	if #rows == 0 then
		UI.text({ Text = "No sales in this period", TextColor3 = C.Faint, LayoutOrder = 1, Parent = card })
	end
	local best = if rows[1] then math.max(rows[1].value, 1) else 1
	for i, row in rows do
		local bar = UI.new(
			"Frame",
			{ BackgroundColor3 = colour, Size = UDim2.fromScale(0, 1), Children = { UI.corner(Theme.Radius.Pill) } }
		)
		UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = i,
			Parent = card,
			Children = {
				UI.text({ Text = row.label, TextSize = 15, Size = UDim2.new(0.6, 0, 0, 20) }),
				UI.text({
					Text = row.sub,
					TextSize = 12,
					TextColor3 = C.Muted,
					Position = UDim2.fromScale(0.6, 0),
					Size = UDim2.new(0.4, 0, 0, 20),
					TextXAlignment = Enum.TextXAlignment.Right,
				}),
				UI.new("Frame", {
					BackgroundColor3 = C.Panel,
					Position = UDim2.fromOffset(0, 26),
					Size = UDim2.new(1, 0, 0, 8),
					Children = { UI.corner(Theme.Radius.Pill), bar },
				}),
			},
		})
		UI.tween(bar, { Size = UDim2.fromScale(row.value / best, 1) }, Theme.TweenSlow)
	end
end

function Reports.new(_ctx)
	local self = {}
	local frame = UI.new("Frame", { Name = "Reports", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.frame = frame
	local body = UI.scroll({ Parent = frame, Children = { UI.list(14), UI.padding(0, 8, 8, 0) } })

	local function render(days)
		UI.clear(body)

		local week = Aggregate.new()
		for _, day in days do
			Aggregate.merge(week, day.totals)
		end
		local net = Aggregate.net(week)

		UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 42),
			LayoutOrder = 1,
			Parent = body,
			Children = {
				UI.text({ Text = "Last 7 days", TextSize = 24, FontFace = F.Heavy, Size = UDim2.new(0.5, 0, 0, 30) }),
				UI.text({
					Text = "All registers on all servers",
					TextSize = 14,
					TextColor3 = C.Muted,
					Position = UDim2.fromOffset(0, 28),
					Size = UDim2.new(0.5, 0, 0, 16),
				}),
				UI.button({
					Text = "↻ Refresh",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.fromScale(1, 0),
					Size = UDim2.fromOffset(120, 40),
					OnClick = function()
						task.spawn(self.show)
					end,
				}),
			},
		})

		local stats = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 86),
			LayoutOrder = 2,
			Parent = body,
			Children = {
				UI.new("UIGridLayout", {
					CellSize = UDim2.new(0.25, -9, 1, 0),
					CellPadding = UDim2.fromOffset(12, 0),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
			},
		})
		UI.stat("Net takings", money(net), C.Success, 1).Parent = stats
		UI.stat("Sales", Format.number(week.count), nil, 2).Parent = stats
		UI.stat("Items sold", Format.number(week.items), nil, 3).Parent = stats
		UI.stat("Discounts given", money(week.discounts), C.Warning, 4).Parent = stats

		-- Bar chart
		local chart = UI.card({
			Size = UDim2.new(1, 0, 0, 260),
			LayoutOrder = 3,
			Parent = body,
			Children = { UI.padding(16) },
		})
		UI.text({ Text = "Net takings per day", FontFace = F.Bold, Parent = chart })
		local plot = UI.new("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 32),
			Size = UDim2.new(1, 0, 1, -32),
			Parent = chart,
			Children = {
				UI.new("UIListLayout", {
					FillDirection = Enum.FillDirection.Horizontal,
					HorizontalFlex = Enum.UIFlexAlignment.Fill,
					Padding = UDim.new(0, 12),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
			},
		})
		local peak = 1
		for _, day in days do
			peak = math.max(peak, Aggregate.net(day.totals))
		end
		for i, day in days do
			local value = Aggregate.net(day.totals)
			local isToday = i == #days
			local bar = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.fromScale(0.5, 1),
				Size = UDim2.fromScale(0.7, 0),
				BackgroundColor3 = if isToday then C.Accent else C.AccentSoft,
				Children = {
					UI.corner(6),
					UI.new("UIGradient", { Transparency = NumberSequence.new(0, 0.35), Rotation = 90 }),
				},
			})
			UI.new("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(0, 1),
				LayoutOrder = i,
				Parent = plot,
				Children = {
					UI.text({
						Text = if value ~= 0 then money(value) else "–",
						TextSize = 13,
						FontFace = F.Bold,
						TextColor3 = if isToday then C.Text else C.Muted,
						TextXAlignment = Enum.TextXAlignment.Center,
						Size = UDim2.new(1, 0, 0, 18),
					}),
					UI.new("Frame", {
						BackgroundTransparency = 1,
						Position = UDim2.fromOffset(0, 22),
						Size = UDim2.new(1, 0, 1, -48),
						Children = { bar },
					}),
					UI.text({
						Text = day.label,
						TextSize = 13,
						TextColor3 = if isToday then C.Text else C.Muted,
						TextXAlignment = Enum.TextXAlignment.Center,
						AnchorPoint = Vector2.new(0, 1),
						Position = UDim2.fromScale(0, 1),
						Size = UDim2.new(1, 0, 0, 20),
					}),
				},
			})
			task.delay(i * 0.04, function()
				UI.tween(bar, { Size = UDim2.fromScale(0.7, math.max(value, 0) / peak) }, Theme.TweenSlow)
			end)
		end

		local lists = UI.new("Frame", {
			BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.fromScale(1, 0),
			LayoutOrder = 4,
			Parent = body,
			Children = { UI.list(12, Enum.FillDirection.Horizontal) },
		})
		local productRows = {}
		for _, item in Aggregate.topProducts(week, 6) do
			table.insert(productRows, {
				label = item.name,
				value = item.total,
				sub = string.format("%d sold · %s", item.qty, money(item.total)),
			})
		end
		rankList(lists, "Best sellers", productRows, C.Accent, 1)
		local cashierRows = {}
		for _, cashier in Aggregate.topCashiers(week, 6) do
			table.insert(cashierRows, {
				label = cashier.name,
				value = cashier.total,
				sub = string.format("%d sales · %s", cashier.count, money(cashier.total)),
			})
		end
		rankList(lists, "Top cashiers", cashierRows, C.Success, 2)

		if week.refundCount > 0 then
			UI.text({
				Text = string.format(
					"Refunds: %d totalling %s (already taken off net takings)",
					week.refundCount,
					money(week.refunds)
				),
				TextColor3 = C.Muted,
				TextSize = 14,
				LayoutOrder = 5,
				Parent = body,
			})
		end
	end

	function self.show()
		UI.clear(body)
		UI.text({ Text = "Loading reports…", TextColor3 = C.Faint, Parent = body })
		local ok, days = Api.call("reports.days", 7)
		if ok then
			render(days)
		else
			Toasts.show(days, "error")
		end
	end

	return self
end

return Reports
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Sales</string>
              <string name="Source"><![CDATA[-- Sales history: the latest receipts across every server, lookup by receipt number, refunds.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Roles = require(Shared.Roles)

local Client = script.Parent.Parent
local Api = require(Client.Api)
local Receipt = require(Client.Receipt)
local State = require(Client.State)
local UI = require(Client.UI.UI)
local Theme = require(Client.UI.Theme)
local Toasts = require(Client.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Sales = {}

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

-- Column layout shared by the header and rows: { label, x scale, width scale, align }
local COLUMNS = {
	{ "Receipt", 0, 0.18 },
	{ "Time", 0.18, 0.16 },
	{ "Cashier → Customer", 0.34, 0.32 },
	{ "Items", 0.66, 0.08, "right" },
	{ "Total", 0.74, 0.12, "right" },
	{ "", 0.88, 0.12, "right" },
}

local function cell(text: string, column, props: { [string]: any }?)
	local label = UI.text({
		Text = text,
		Position = UDim2.new(column[2], 8, 0, 0),
		Size = UDim2.new(column[3], -16, 1, 0),
		TextXAlignment = if column[4] == "right" then Enum.TextXAlignment.Right else Enum.TextXAlignment.Left,
		TextSize = 15,
	})
	for key, value in (props or {}) :: { [string]: any } do
		(label :: any)[key] = value
	end
	return label
end

function Sales.new(ctx)
	local self = {}
	local frame = UI.new("Frame", { Name = "Sales", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.frame = frame

	UI.text({ Text = "Sales", TextSize = 24, FontFace = F.Heavy, Size = UDim2.new(0.4, 0, 0, 42), Parent = frame })
	local find = UI.input({
		Placeholder = "Receipt number, e.g. " .. Format.receipt(Config.Store.ReceiptPrefix, 42),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -230, 0, 0),
		Size = UDim2.fromOffset(280, 42),
	})
	find.Parent = frame

	local list
	local refresh -- forward

	local function open(receipt: string)
		local ok, sale = Api.call("sales.get", receipt)
		if not ok then
			Toasts.show(sale, "error")
			return
		end
		Receipt.showSale(ctx.overlay, sale, {
			canRefund = State.role >= Roles.Manager,
			onChanged = function()
				task.spawn(refresh)
			end,
		})
	end

	UI.button({
		Text = "Find",
		Style = "primary",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -130, 0, 0),
		Size = UDim2.fromOffset(90, 42),
		Parent = frame,
		OnClick = function()
			local text = string.gsub(find.Text, "%s", "")
			if text ~= "" then
				open(string.upper(text))
			end
		end,
	})
	UI.button({
		Text = "↻ Refresh",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(120, 42),
		Parent = frame,
		OnClick = function()
			task.spawn(refresh)
		end,
	})

	local head = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, -8, 0, 24),
		Parent = frame,
	})
	for _, column in COLUMNS do
		cell(column[1], column, { TextSize = 13, TextColor3 = C.Faint, FontFace = F.Bold }).Parent = head
	end

	list = UI.scroll({
		Position = UDim2.fromOffset(0, 86),
		Size = UDim2.new(1, 0, 1, -86),
		Parent = frame,
		Children = { UI.list(6) },
	})

	function refresh()
		local ok, sales = Api.call("sales.recent", 100)
		UI.clear(list)
		if not ok then
			Toasts.show(sales, "error")
			return
		end
		if #sales == 0 then
			UI.text({ Text = "No sales yet. Ring something up on the Sell tab.", TextColor3 = C.Faint, Parent = list })
		end
		for i, sale in sales do
			local row = UI.new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = C.Raised,
				Size = UDim2.new(1, -8, 0, 50),
				LayoutOrder = i,
				Parent = list,
				Children = { UI.corner(Theme.Radius.Medium) },
			})
			cell(sale.receipt, COLUMNS[1], { FontFace = F.MonoBold, TextSize = 14 }).Parent = row
			cell(Format.dateTime(sale.t), COLUMNS[2], { TextColor3 = C.Muted }).Parent = row
			cell(sale.cashier .. "  →  " .. sale.customer, COLUMNS[3]).Parent = row
			cell(tostring(sale.items), COLUMNS[4], { TextColor3 = C.Muted }).Parent = row
			cell(money(sale.total), COLUMNS[5], { FontFace = F.Bold }).Parent = row
			local status = if sale.refunded
				then UI.pill("Refunded", C.Danger, C.DangerSoft)
				else UI.pill("Paid", C.Success, C.SuccessSoft)
			status.AnchorPoint = Vector2.new(1, 0.5)
			status.Position = UDim2.new(1, -12, 0.5, 0)
			status.Parent = row

			row.MouseEnter:Connect(function()
				UI.tween(row, { BackgroundColor3 = C.RaisedHover })
			end)
			row.MouseLeave:Connect(function()
				UI.tween(row, { BackgroundColor3 = C.Raised })
			end)
			row.Activated:Connect(function()
				open(sale.receipt)
			end)
		end
	end

	self.show = refresh
	return self
end

return Sales
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Sell</string>
              <string name="Source"><![CDATA[-- Sell: product grid on the left, order on the right. Totals are computed with the same
-- Pricing module the server uses, so the preview always matches what the customer is charged.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Pricing = require(Shared.Pricing)

local Client = script.Parent.Parent
local Api = require(Client.Api)
local Receipt = require(Client.Receipt)
local State = require(Client.State)
local UI = require(Client.UI.UI)
local Theme = require(Client.UI.Theme)
local Toasts = require(Client.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Sell = {}

local CART_WIDTH = 368
local BOTTOM_HEIGHT = 244

local current -- the live screen instance; push listeners forward to it

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

local function stockBadge(product): (string?, Color3?, Color3?)
	if product.stock == nil then
		return nil
	elseif product.stock <= 0 then
		return "Sold out", C.Danger, C.DangerSoft
	elseif product.stock <= Config.Inventory.LowStockAt then
		return string.format("Low · %d", product.stock), C.Warning, C.WarningSoft
	end
	return string.format("%d left", product.stock), C.Muted, C.Panel
end

function Sell.new(ctx)
	local self = {}

	local cart: { { productId: string, qty: number } } = {}
	local discount = 0
	local customer: { userId: number, name: string }? = nil
	local pending: { orderId: string, customer: string, total: number }? = nil
	local category = "All"
	local query = ""
	local tiles: { [string]: { stroke: UIStroke, badge: Frame, scale: UIScale } } = {}
	local previewToken = 0

	local frame = UI.new("Frame", { Name = "Sell", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.frame = frame

	------------------------------------------------------------------ left: catalogue
	local left = UI.new("Frame", {
		Name = "Catalogue",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -(CART_WIDTH + 16), 1, 0),
		Parent = frame,
	})
	local search = UI.input({ Placeholder = "🔍  Search products", Size = UDim2.new(1, 0, 0, 42), Parent = left })
	search.Parent = left
	local chips = UI.scroll({
		Name = "Categories",
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 0, 36),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X,
		ScrollBarThickness = 0,
		Parent = left,
		Children = { UI.list(8, Enum.FillDirection.Horizontal) },
	})
	local grid = UI.scroll({
		Name = "Grid",
		Position = UDim2.fromOffset(0, 100),
		Size = UDim2.new(1, 0, 1, -100),
		Parent = left,
		Children = {
			UI.new("UIGridLayout", {
				CellSize = UDim2.fromOffset(166, 114),
				CellPadding = UDim2.fromOffset(10, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
			UI.padding(2, 8, 8, 2),
		},
	})

	------------------------------------------------------------------ right: order
	local panel = UI.new("Frame", {
		Name = "Order",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, CART_WIDTH, 1, 0),
		BackgroundColor3 = C.Panel,
		Parent = frame,
		Children = { UI.corner(Theme.Radius.Large), UI.stroke(), UI.padding(14) },
	})
	UI.text({
		Text = "Current order",
		TextSize = 18,
		FontFace = F.Heavy,
		Size = UDim2.new(1, -80, 0, 28),
		Parent = panel,
	})
	local clearButton = UI.button({
		Text = "Clear",
		Style = "ghost",
		TextSize = 14,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(70, 28),
	})
	clearButton.Parent = panel

	local customerButton = UI.button({
		Text = "",
		Style = "secondary",
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 46),
		Font = F.Medium,
		TextSize = 15,
	})
	customerButton.TextXAlignment = Enum.TextXAlignment.Left
	UI.padding(0, 14).Parent = customerButton
	customerButton.Parent = panel

	local lines = UI.scroll({
		Name = "Lines",
		Position = UDim2.fromOffset(0, 94),
		Size = UDim2.new(1, 0, 1, -(94 + BOTTOM_HEIGHT)),
		Parent = panel,
		Children = { UI.list(6) },
	})
	local empty = UI.text({
		Text = "Tap a product to add it to the order",
		TextColor3 = C.Faint,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = true,
		Position = UDim2.fromOffset(0, 94),
		Size = UDim2.new(1, 0, 1, -(94 + BOTTOM_HEIGHT)),
		Parent = panel,
	})

	local bottom = UI.new("Frame", {
		Name = "Summary",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, BOTTOM_HEIGHT),
		Parent = panel,
	})
	UI.new("Frame", { BackgroundColor3 = C.Border, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), Parent = bottom })
	UI.text({
		Text = "Discount",
		TextSize = 13,
		TextColor3 = C.Muted,
		Position = UDim2.fromOffset(0, 10),
		Parent = bottom,
	})
	local discountRow = UI.new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 30),
		Parent = bottom,
		Children = { UI.list(6, Enum.FillDirection.Horizontal) },
	})

	local function totalLine(y: number, label: string, strong: boolean?)
		local name = UI.text({
			Text = label,
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.new(0.5, 0, 0, if strong then 34 else 20),
			TextSize = if strong then 20 else 15,
			FontFace = if strong then F.Heavy else F.Medium,
			TextColor3 = if strong then C.Text else C.Muted,
			Parent = bottom,
		})
		local value = UI.text({
			Text = "",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, y),
			Size = UDim2.new(0.5, 0, 0, if strong then 34 else 20),
			TextSize = if strong then 28 else 15,
			FontFace = if strong then F.Heavy else F.Medium,
			TextColor3 = if strong then C.Text else C.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = bottom,
		})
		return name, value
	end
	local _, subtotalValue = totalLine(74, "Subtotal")
	local discountName, discountValue = totalLine(96, "Discount")
	local taxName, taxValue = totalLine(118, Config.Tax.Name)
	local _, totalValue = totalLine(142, "Total", true)

	local charge = UI.button({
		Text = "Charge",
		Style = "primary",
		TextSize = 19,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 54),
		Radius = Theme.Radius.Medium,
	})
	charge.Parent = bottom

	-- Waiting-for-payment overlay
	local waitScale = UI.new("UIScale")
	local waitBar = UI.new(
		"Frame",
		{ BackgroundColor3 = C.Accent, Size = UDim2.fromScale(1, 1), Children = { UI.corner(Theme.Radius.Pill) } }
	)
	local waitTitle = UI.text({
		Text = "",
		TextSize = 22,
		FontFace = F.Heavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 2,
		TextWrapped = true,
	})
	local waitTotal = UI.text({
		Text = "",
		TextSize = 40,
		FontFace = F.Heavy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 48),
		LayoutOrder = 3,
	})
	local waiting = UI.new("TextButton", {
		Name = "Waiting",
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.04,
		Size = UDim2.new(1, 28, 1, 28),
		Position = UDim2.fromOffset(-14, -14),
		ZIndex = 10,
		Parent = panel,
		Children = {
			UI.corner(Theme.Radius.Large),
			UI.padding(28),
			UI.list(14, nil, {
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				VerticalAlignment = Enum.VerticalAlignment.Center,
			}),
			waitScale,
			UI.new("TextLabel", {
				Text = "⏳",
				TextSize = 34,
				BackgroundColor3 = C.AccentSoft,
				Size = UDim2.fromOffset(72, 72),
				LayoutOrder = 1,
				Children = { UI.corner(Theme.Radius.Pill) },
			}),
			waitTitle,
			waitTotal,
			UI.text({
				Text = "The customer approves the payment on their screen",
				TextSize = 14,
				TextColor3 = C.Muted,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Center,
				Size = UDim2.new(1, 0, 0, 36),
				LayoutOrder = 4,
			}),
			UI.new("Frame", {
				BackgroundColor3 = C.Raised,
				Size = UDim2.new(1, 0, 0, 6),
				LayoutOrder = 5,
				Children = { UI.corner(Theme.Radius.Pill), waitBar },
			}),
		},
	})
	local cancelWait =
		UI.button({ Text = "Cancel payment", Style = "ghost", Size = UDim2.new(1, 0, 0, 42), LayoutOrder = 6 })
	cancelWait.Parent = waiting

	-- Customer picker
	local picker = UI.new("Frame", {
		Name = "Picker",
		Visible = false,
		BackgroundColor3 = C.Raised,
		Position = UDim2.fromOffset(0, 88),
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 8,
		Parent = panel,
		Children = { UI.corner(Theme.Radius.Medium), UI.stroke(C.Accent, 1, 0.3), UI.padding(8), UI.list(4) },
	})

	------------------------------------------------------------------ logic
	local function payload()
		local out = {}
		for _, line in cart do
			table.insert(out, { productId = line.productId, qty = line.qty })
		end
		return out
	end

	local function totals(): Pricing.Totals
		local priced = {}
		for _, line in cart do
			local product = State.byId[line.productId]
			if product then
				table.insert(priced, {
					productId = product.id,
					name = product.name,
					unitPrice = product.price,
					qty = line.qty,
					taxRate = if Config.Tax.Enabled then product.taxRate else 0,
				})
			end
		end
		return Pricing.priceLines(priced, { discountPct = discount, taxInclusive = Config.Tax.Inclusive })
	end

	local function schedulePreview()
		previewToken += 1
		local token = previewToken
		task.delay(0.35, function()
			if token == previewToken and State.register then
				Api.call("register.preview", payload(), discount)
			end
		end)
	end

	local renderCart -- forward declaration

	local function qtyIn(productId: string): number
		for _, line in cart do
			if line.productId == productId then
				return line.qty
			end
		end
		return 0
	end

	local function setQty(productId: string, qty: number)
		local product = State.byId[productId]
		if not product then
			return
		end
		if qty > Config.Checkout.MaxQty then
			Toasts.show(string.format("You can sell at most %d of one item", Config.Checkout.MaxQty), "warning")
			return
		end
		if product.stock ~= nil and qty > product.stock then
			Toasts.show(
				if product.stock == 0
					then product.name .. " is sold out"
					else string.format("Only %d %s left", product.stock, product.name),
				"warning"
			)
			return
		end
		for i, line in cart do
			if line.productId == productId then
				if qty <= 0 then
					table.remove(cart, i)
				else
					line.qty = qty
				end
				renderCart()
				return
			end
		end
		if qty > 0 then
			if #cart >= Config.Checkout.MaxLines then
				Toasts.show(
					string.format("An order can have at most %d different items", Config.Checkout.MaxLines),
					"warning"
				)
				return
			end
			table.insert(cart, { productId = productId, qty = qty })
			renderCart()
		end
	end

	local function updateTiles()
		for id, tile in tiles do
			local qty = qtyIn(id)
			tile.badge.Visible = qty > 0
			local label = tile.badge:FindFirstChild("Label") :: TextLabel?
			if label then
				label.Text = "×" .. qty
			end
			UI.tween(
				tile.stroke,
				{ Color = if qty > 0 then C.Accent else C.Border, Thickness = if qty > 0 then 2 else 1 }
			)
		end
	end

	local function renderGrid()
		UI.clear(grid)
		table.clear(tiles)
		local needle = string.lower(query)
		for index, product in State.catalogue do
			local matchesCategory = category == "All" or product.category == category
			local matchesQuery = needle == "" or string.find(string.lower(product.name), needle, 1, true) ~= nil
			if product.active and matchesCategory and matchesQuery then
				local soldOut = product.stock ~= nil and product.stock <= 0
				local stroke = UI.stroke()
				local scale = UI.new("UIScale")
				local badgeText, badgeFg, badgeBg = stockBadge(product)
				local inCart = UI.pill("×0", Color3.new(1, 1, 1), C.Accent, {
					Visible = false,
					AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -10, 1, -10),
				})
				local tile = UI.new("TextButton", {
					Name = product.id,
					Text = "",
					AutoButtonColor = false,
					LayoutOrder = index,
					BackgroundColor3 = C.Raised,
					Parent = grid,
					Children = {
						UI.corner(Theme.Radius.Medium),
						stroke,
						scale,
						UI.new("TextLabel", {
							Text = string.upper(string.sub(product.name, 1, 1)),
							FontFace = F.Heavy,
							TextSize = 18,
							TextColor3 = Color3.new(1, 1, 1),
							TextStrokeTransparency = 0.7,
							BackgroundColor3 = product.colour,
							Position = UDim2.fromOffset(12, 12),
							Size = UDim2.fromOffset(36, 36),
							Children = {
								UI.corner(10),
								UI.new("UIGradient", {
									Transparency = NumberSequence.new(0, 0.25),
									Rotation = 90,
								}),
							},
						}),
						if badgeText
							then UI.pill(badgeText, badgeFg :: Color3, badgeBg :: Color3, {
								AnchorPoint = Vector2.new(1, 0),
								Position = UDim2.new(1, -10, 0, 12),
								Size = UDim2.fromOffset(0, 22),
							})
							else nil,
						UI.text({
							Text = product.name,
							FontFace = F.Bold,
							TextSize = 16,
							TextColor3 = if soldOut then C.Faint else C.Text,
							Position = UDim2.fromOffset(12, 56),
							Size = UDim2.new(1, -24, 0, 20),
						}),
						UI.text({
							Text = money(product.price),
							FontFace = F.Heavy,
							TextSize = 19,
							TextColor3 = if soldOut then C.Faint else C.AccentHover,
							Position = UDim2.fromOffset(12, 80),
							Size = UDim2.new(1, -70, 0, 22),
						}),
						inCart,
					},
				})
				tiles[product.id] = { stroke = stroke, badge = inCart, scale = scale }
				tile.MouseEnter:Connect(function()
					UI.tween(tile, { BackgroundColor3 = C.RaisedHover })
				end)
				tile.MouseLeave:Connect(function()
					UI.tween(tile, { BackgroundColor3 = C.Raised })
				end)
				tile.Activated:Connect(function()
					if pending then
						return
					end
					scale.Scale = 0.93
					UI.tween(scale, { Scale = 1 }, Theme.TweenSlow)
					setQty(product.id, qtyIn(product.id) + 1)
				end)
			end
		end
		if #grid:GetChildren() <= 2 then
			UI.text({
				Text = "No products match",
				TextColor3 = C.Faint,
				Parent = grid,
			})
		end
		updateTiles()
	end

	local function renderChips()
		UI.clear(chips)
		local names = { "All" }
		for _, name in Config.Categories do
			table.insert(names, name)
		end
		for i, name in names do
			local selected = name == category
			local chip = UI.button({
				Text = name,
				Style = if selected then "primary" else "secondary",
				TextSize = 14,
				Size = UDim2.fromScale(0, 1),
				LayoutOrder = i,
				Radius = Theme.Radius.Pill,
				OnClick = function()
					category = name
					renderChips()
					renderGrid()
				end,
			})
			chip.AutomaticSize = Enum.AutomaticSize.X
			UI.padding(0, 16).Parent = chip
			chip.Parent = chips
		end
	end

	local function renderDiscounts()
		UI.clear(discountRow)
		for i, pct in Config.Discounts.Presets do
			if pct <= State.maxDiscount then
				UI.button({
					Text = if pct == 0 then "None" else pct .. "%",
					Style = if pct == discount then "primary" else "secondary",
					TextSize = 13,
					Size = UDim2.new(0, if pct == 0 then 54 else 44, 1, 0),
					LayoutOrder = i,
					Parent = discountRow,
					OnClick = function()
						discount = pct
						renderDiscounts()
						renderCart()
					end,
				})
			end
		end
	end

	local function updateCustomerButton()
		customerButton.Text = if customer then "👤  " .. customer.name else "👤  Choose customer   ▾"
		customerButton.TextColor3 = if customer then C.Text else C.Muted
	end

	local function updateCharge(total: number)
		local register = State.register
		if not register or not register.shift then
			charge.Text = "Open a shift to take payments"
			UI.setEnabled(charge, true)
			charge:SetAttribute("Action", "shift")
		elseif #cart == 0 then
			charge.Text = "Charge"
			UI.setEnabled(charge, false)
			charge:SetAttribute("Action", nil)
		elseif not customer then
			charge.Text = "Choose a customer"
			UI.setEnabled(charge, true)
			charge:SetAttribute("Action", "customer")
		else
			charge.Text = "Charge " .. money(total)
			UI.setEnabled(charge, true)
			charge:SetAttribute("Action", "charge")
		end
	end

	function renderCart()
		UI.clear(lines)
		local result = totals()
		for i, line in result.lines do
			local product = State.byId[line.productId]
			local row = UI.new("Frame", {
				Name = line.productId,
				BackgroundColor3 = C.Raised,
				Size = UDim2.new(1, -6, 0, 54),
				LayoutOrder = i,
				Parent = lines,
				Children = {
					UI.corner(Theme.Radius.Medium),
					UI.new("Frame", {
						BackgroundColor3 = if product then product.colour else C.Accent,
						Position = UDim2.fromOffset(0, 10),
						Size = UDim2.new(0, 4, 1, -20),
						Children = { UI.corner(2) },
					}),
					UI.text({
						Text = line.name or line.productId,
						FontFace = F.Bold,
						TextSize = 15,
						Position = UDim2.fromOffset(14, 8),
						Size = UDim2.new(1, -190, 0, 20),
					}),
					UI.text({
						Text = money(line.unitPrice) .. " each",
						TextSize = 13,
						TextColor3 = C.Muted,
						Position = UDim2.fromOffset(14, 28),
						Size = UDim2.new(1, -190, 0, 18),
					}),
					UI.text({
						Text = money(line.unitPrice * line.qty),
						FontFace = F.Bold,
						TextSize = 15,
						TextXAlignment = Enum.TextXAlignment.Right,
						AnchorPoint = Vector2.new(1, 0.5),
						Position = UDim2.new(1, -12, 0.5, 0),
						Size = UDim2.fromOffset(64, 20),
					}),
				},
			})
			local stepper = UI.new("Frame", {
				BackgroundColor3 = C.Panel,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -84, 0.5, 0),
				Size = UDim2.fromOffset(96, 32),
				Parent = row,
				Children = { UI.corner(Theme.Radius.Small) },
			})
			UI.button({
				Text = "−",
				Style = "ghost",
				Size = UDim2.fromOffset(32, 32),
				OnClick = function()
					if not pending then
						setQty(line.productId, line.qty - 1)
					end
				end,
			}).Parent =
				stepper
			UI.text({
				Text = tostring(line.qty),
				FontFace = F.Heavy,
				TextXAlignment = Enum.TextXAlignment.Center,
				Position = UDim2.fromOffset(32, 0),
				Size = UDim2.fromOffset(32, 32),
				Parent = stepper,
			})
			UI.button({
				Text = "+",
				Style = "ghost",
				Position = UDim2.fromOffset(64, 0),
				Size = UDim2.fromOffset(32, 32),
				OnClick = function()
					if not pending then
						setQty(line.productId, line.qty + 1)
					end
				end,
			}).Parent =
				stepper
		end

		empty.Visible = #cart == 0
		subtotalValue.Text = money(result.subtotal)
		discountName.Visible = result.discount > 0
		discountValue.Visible = result.discount > 0
		discountName.Text = string.format("Discount (%d%%)", discount)
		discountValue.Text = "-" .. money(result.discount)
		taxName.Visible = Config.Tax.Enabled
		taxValue.Visible = Config.Tax.Enabled
		taxValue.Text = money(result.tax)
		totalValue.Text = money(result.total)
		updateCharge(result.total)
		updateTiles()
		schedulePreview()
	end

	local function showWaiting(visible: boolean)
		if visible and pending then
			waitTitle.Text = "Waiting for " .. pending.customer
			waitTotal.Text = money(pending.total)
			waiting.Visible = true
			waitScale.Scale = 0.95
			UI.tween(waitScale, { Scale = 1 }, Theme.TweenSlow)
			waitBar.Size = UDim2.fromScale(1, 1)
			waitBar.BackgroundColor3 = C.Accent
			UI.tween(
				waitBar,
				{ Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Warning },
				TweenInfo.new(Config.Checkout.PaymentTimeout, Enum.EasingStyle.Linear)
			)
			UI.setEnabled(cancelWait, true)
		else
			waiting.Visible = false
		end
	end

	local function closePicker()
		picker.Visible = false
	end

	local function openPicker()
		UI.clear(picker)
		picker.Visible = true
		UI.text({
			Text = "Looking for customers nearby…",
			TextSize = 14,
			TextColor3 = C.Muted,
			ZIndex = 9,
			Parent = picker,
		})
		local ok, nearby = Api.call("register.customers")
		if not picker.Visible then
			return
		end
		UI.clear(picker)
		if not ok then
			Toasts.show(nearby, "error")
			closePicker()
			return
		end
		if #nearby == 0 then
			UI.text({
				Text = "Nobody is at the counter. Ask the customer to stand at the register.",
				TextSize = 14,
				TextColor3 = C.Muted,
				TextWrapped = true,
				Size = UDim2.new(1, 0, 0, 40),
				ZIndex = 9,
				Parent = picker,
			})
		end
		for i, person in nearby do
			local option = UI.button({
				Text = string.format(
					"%s  ·  @%s%s",
					person.name,
					person.username,
					if person.isYou then "  (you)" else ""
				),
				Style = "ghost",
				Font = F.Medium,
				TextSize = 15,
				Size = UDim2.new(1, 0, 0, 38),
				LayoutOrder = i,
				ZIndex = 9,
				OnClick = function()
					customer = { userId = person.userId, name = person.name }
					closePicker()
					updateCustomerButton()
					renderCart()
				end,
			})
			option.TextXAlignment = Enum.TextXAlignment.Left
			UI.padding(0, 10).Parent = option
			option.Parent = picker
		end
		UI.button({
			Text = "↻ Refresh",
			Style = "ghost",
			TextSize = 13,
			Size = UDim2.new(1, 0, 0, 30),
			LayoutOrder = 100,
			ZIndex = 9,
			OnClick = function()
				task.spawn(openPicker)
			end,
		}).Parent =
			picker
	end

	------------------------------------------------------------------ wiring
	search:GetPropertyChangedSignal("Text"):Connect(function()
		query = search.Text
		renderGrid()
	end)

	clearButton.Activated:Connect(function()
		if pending then
			return
		end
		table.clear(cart)
		discount = 0
		customer = nil
		renderDiscounts()
		updateCustomerButton()
		renderCart()
	end)

	customerButton.Activated:Connect(function()
		if pending then
			return
		end
		if picker.Visible then
			closePicker()
		else
			task.spawn(openPicker)
		end
	end)

	charge.Activated:Connect(function()
		local action = charge:GetAttribute("Action")
		if charge:GetAttribute("Disabled") or pending then
			return
		elseif action == "shift" then
			ctx.go("shift")
		elseif action == "customer" then
			task.spawn(openPicker)
		elseif action == "charge" and customer then
			UI.setEnabled(charge, false)
			charge.Text = "Sending…"
			local ok, result = Api.call("checkout.start", payload(), discount, customer.userId)
			if ok then
				pending = { orderId = result.orderId, customer = result.customer, total = result.total }
				showWaiting(true)
			else
				Toasts.show(result, "error")
			end
			renderCart()
		end
	end)

	cancelWait.Activated:Connect(function()
		if pending then
			UI.setEnabled(cancelWait, false)
			local ok, err = Api.call("checkout.cancel", pending.orderId)
			if not ok then
				Toasts.show(err, "error")
				UI.setEnabled(cancelWait, true)
			end
		end
	end)

	function self.onOrderUpdate(update)
		if not pending or pending.orderId ~= update.orderId then
			return
		end
		pending = nil
		showWaiting(false)
		if update.status == "paid" then
			local sale = update.sale
			Toasts.show(string.format("Paid %s · %s", money(sale.total), sale.receipt), "success")
			table.clear(cart)
			discount = 0
			customer = nil
			renderDiscounts()
			updateCustomerButton()
			Receipt.showSale(ctx.overlay, sale)
		else
			Toasts.show(update.reason or "Payment was not completed", "warning")
		end
		renderCart()
	end

	function self.onClosed()
		pending = nil
		showWaiting(false)
		closePicker()
	end

	State.changed:Connect(function(key)
		if key == "catalogue" then
			-- Drop anything taken off sale, then redraw with new prices and stock.
			for i = #cart, 1, -1 do
				local product = State.byId[cart[i].productId]
				if not product or not product.active then
					table.remove(cart, i)
				end
			end
			renderGrid()
			renderCart()
		elseif key == "register" then
			renderCart()
		end
	end)

	function self.show()
		search.Text = query
	end

	renderChips()
	renderDiscounts()
	updateCustomerButton()
	renderGrid()
	renderCart()

	current = self
	return self
end

Api.on("OrderUpdate", function(update)
	if current then
		current.onOrderUpdate(update)
	end
end)

Api.on("CloseRegister", function()
	if current then
		current.onClosed()
	end
end)

return Sell
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Shift</string>
              <string name="Source"><![CDATA[-- Shift: open it to take payments, watch the live X report, close it for the Z report.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local Client = script.Parent.Parent
local Api = require(Client.Api)
local Receipt = require(Client.Receipt)
local State = require(Client.State)
local UI = require(Client.UI.UI)
local Theme = require(Client.UI.Theme)
local Toasts = require(Client.UI.Toasts)

local C, F = Theme.Colors, Theme.Fonts

local Shift = {}

local function money(n: number): string
	return Format.money(n, Config.Currency.Symbol)
end

function Shift.new(ctx)
	local self = {}
	local frame = UI.new("Frame", { Name = "Shift", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) })
	self.frame = frame
	local body = UI.scroll({ Parent = frame, Children = { UI.list(14), UI.padding(0, 8, 8, 0) } })

	local render -- forward

	local function act(action: string, after: (any) -> ())
		local ok, result = Api.call(action)
		if ok then
			after(result)
		else
			Toasts.show(result, "error")
		end
	end

	local function openShift()
		act("shift.open", function(summary)
			State.set("register", summary)
			Toasts.show("Shift opened on " .. summary.name, "success")
		end)
	end

	local function closeShift()
		local dialog, close = UI.modal(ctx.overlay, { Title = "Close shift?", Width = 380 })
		UI.text({
			Text = "This ends the shift on " .. State.register.name .. " and prints the Z report.",
			TextWrapped = true,
			TextColor3 = C.Muted,
			Size = UDim2.new(1, 0, 0, 44),
			LayoutOrder = 1,
			Parent = dialog,
		})
		local actions = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 42),
			LayoutOrder = 2,
			Parent = dialog,
			Children = {
				UI.list(10, Enum.FillDirection.Horizontal, { HorizontalAlignment = Enum.HorizontalAlignment.Right }),
			},
		})
		UI.button({
			Text = "Keep open",
			LayoutOrder = 1,
			Size = UDim2.fromOffset(110, 42),
			Parent = actions,
			OnClick = close,
		})
		UI.button({
			Text = "Close shift",
			Style = "danger",
			LayoutOrder = 2,
			Size = UDim2.fromOffset(130, 42),
			Parent = actions,
			OnClick = function()
				close()
				act("shift.close", function(report)
					local register = table.clone(State.register)
					register.shift = nil
					State.set("register", register)
					Receipt.showReport(ctx.overlay, "Z REPORT", report)
				end)
			end,
		})
	end

	function render()
		UI.clear(body)
		local register = State.register
		if not register then
			return
		end
		local report = register.shift

		if not report then
			UI.card({
				Size = UDim2.new(1, 0, 0, 200),
				LayoutOrder = 1,
				Parent = body,
				Children = {
					UI.padding(28),
					UI.list(12, nil, {
						HorizontalAlignment = Enum.HorizontalAlignment.Center,
						VerticalAlignment = Enum.VerticalAlignment.Center,
					}),
					UI.text({
						Text = "⏱",
						TextSize = 36,
						TextXAlignment = Enum.TextXAlignment.Center,
						Size = UDim2.new(1, 0, 0, 40),
						LayoutOrder = 1,
					}),
					UI.text({
						Text = "No shift open on " .. register.name,
						TextSize = 22,
						FontFace = F.Heavy,
						TextXAlignment = Enum.TextXAlignment.Center,
						Size = UDim2.new(1, 0, 0, 28),
						LayoutOrder = 2,
					}),
					UI.text({
						Text = "Open a shift to start taking payments. Every sale is added to its report.",
						TextColor3 = C.Muted,
						TextXAlignment = Enum.TextXAlignment.Center,
						LayoutOrder = 3,
					}),
					UI.button({
						Text = "Open shift",
						Style = "success",
						Size = UDim2.fromOffset(180, 46),
						LayoutOrder = 4,
						OnClick = openShift,
					}),
				},
			})
			return
		end

		local t = report.totals
		-- Header row
		UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 46),
			LayoutOrder = 1,
			Parent = body,
			Children = {
				UI.text({
					Text = "Shift " .. report.id,
					TextSize = 24,
					FontFace = F.Heavy,
					Size = UDim2.new(0.5, 0, 0, 28),
				}),
				UI.text({
					Text = string.format(
						"Opened %s by %s · running %s",
						Format.clock(report.openedAt),
						report.openedBy,
						Format.duration(os.time() - report.openedAt)
					),
					TextSize = 14,
					TextColor3 = C.Muted,
					Position = UDim2.fromOffset(0, 28),
					Size = UDim2.new(0.6, 0, 0, 18),
				}),
				UI.new("Frame", {
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.fromScale(1, 0),
					Size = UDim2.fromScale(0.4, 1),
					Children = {
						UI.list(
							10,
							Enum.FillDirection.Horizontal,
							{ HorizontalAlignment = Enum.HorizontalAlignment.Right }
						),
						UI.button({
							Text = "X report",
							Size = UDim2.fromOffset(110, 42),
							LayoutOrder = 1,
							OnClick = function()
								act("shift.report", function(summary)
									State.set("register", summary)
									if summary.shift then
										Receipt.showReport(ctx.overlay, "X REPORT", summary.shift)
									end
								end)
							end,
						}),
						UI.button({
							Text = "Close shift",
							Style = "danger",
							Size = UDim2.fromOffset(130, 42),
							LayoutOrder = 2,
							OnClick = closeShift,
						}),
					},
				}),
			},
		})

		-- Stat tiles
		local stats = UI.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 86),
			LayoutOrder = 2,
			Parent = body,
			Children = {
				UI.new("UIGridLayout", {
					CellSize = UDim2.new(0.25, -9, 1, 0),
					CellPadding = UDim2.fromOffset(12, 0),
					SortOrder = Enum.SortOrder.LayoutOrder,
				}),
			},
		})
		UI.stat("Net takings", money(report.net), C.Success, 1).Parent = stats
		UI.stat("Sales", tostring(t.count), nil, 2).Parent = stats
		UI.stat("Average sale", money(report.average), nil, 3).Parent = stats
		UI.stat("Refunds", money(t.refunds), if t.refunds > 0 then C.Danger else nil, 4).Parent = stats

		-- Top items with proportional bars
		local top = UI.card({
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.fromScale(1, 0),
			LayoutOrder = 3,
			Parent = body,
			Children = { UI.padding(16), UI.list(8) },
		})
		UI.text({ Text = "Top items this shift", TextSize = 16, FontFace = F.Bold, Parent = top })
		if #report.topProducts == 0 then
			UI.text({ Text = "Nothing sold yet", TextColor3 = C.Faint, LayoutOrder = 1, Parent = top })
		end
		local best = if report.topProducts[1] then math.max(report.topProducts[1].total, 1) else 1
		for i, item in report.topProducts do
			local bar = UI.new("Frame", {
				BackgroundColor3 = C.Accent,
				Size = UDim2.fromScale(0, 1),
				Children = { UI.corner(Theme.Radius.Pill) },
			})
			UI.new("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 30),
				LayoutOrder = i,
				Parent = top,
				Children = {
					UI.text({ Text = string.format("%d × %s", item.qty, item.name), Size = UDim2.fromScale(0.35, 1) }),
					UI.new("Frame", {
						BackgroundColor3 = C.Panel,
						Position = UDim2.new(0.36, 0, 0.5, -5),
						Size = UDim2.new(0.5, 0, 0, 10),
						Children = { UI.corner(Theme.Radius.Pill), bar },
					}),
					UI.text({
						Text = money(item.total),
						FontFace = F.Bold,
						TextXAlignment = Enum.TextXAlignment.Right,
						Position = UDim2.fromScale(0.86, 0),
						Size = UDim2.fromScale(0.14, 1),
					}),
				},
			})
			UI.tween(bar, { Size = UDim2.fromScale(item.total / best, 1) }, Theme.TweenSlow)
		end
	end

	State.changed:Connect(function(key)
		if key == "register" and frame.Visible then
			render()
		end
	end)

	function self.show()
		act("shift.report", function(summary)
			State.set("register", summary)
		end)
		render()
	end

	return self
end

return Shift
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Client state with a change signal: State.set("register", value) fires State.changed("register").

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("POS")
local Signal = require(Shared.Signal)

local State = {
	role = 0,
	roleName = "Customer",
	maxDiscount = 0,
	persistent = true,
	catalogue = {},
	byId = {},
	register = nil,
}

State.changed = Signal.new()

function State.set(key: string, value: any)
	State[key] = value
	if key == "catalogue" then
		local byId = {}
		for _, product in value do
			byId[product.id] = product
		end
		State.byId = byId
	end
	State.changed:Fire(key, value)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Design tokens. Change these to restyle the whole POS.

local Theme = {}

local rgb = Color3.fromRGB

Theme.Colors = {
	Backdrop = rgb(5, 6, 9),
	Bg = rgb(13, 15, 20),
	Panel = rgb(20, 23, 31),
	Raised = rgb(28, 32, 43),
	RaisedHover = rgb(36, 41, 55),
	Border = rgb(44, 50, 66),
	Text = rgb(236, 239, 245),
	Muted = rgb(146, 153, 170),
	Faint = rgb(98, 105, 124),
	Accent = rgb(92, 132, 255),
	AccentHover = rgb(118, 152, 255),
	AccentSoft = rgb(34, 44, 78),
	Success = rgb(46, 204, 113),
	SuccessHover = rgb(76, 220, 138),
	SuccessSoft = rgb(22, 58, 41),
	Warning = rgb(242, 173, 61),
	WarningSoft = rgb(66, 50, 22),
	Danger = rgb(235, 87, 87),
	DangerHover = rgb(245, 115, 115),
	DangerSoft = rgb(70, 28, 32),
	Paper = rgb(250, 248, 242),
	Ink = rgb(28, 28, 32),
}

local family = "rbxasset://fonts/families/BuilderSans.json"
local mono = "rbxasset://fonts/families/RobotoMono.json"

Theme.Fonts = {
	Regular = Font.new(family, Enum.FontWeight.Regular),
	Medium = Font.new(family, Enum.FontWeight.Medium),
	Bold = Font.new(family, Enum.FontWeight.Bold),
	Heavy = Font.new(family, Enum.FontWeight.ExtraBold),
	Mono = Font.new(mono, Enum.FontWeight.Regular),
	MonoBold = Font.new(mono, Enum.FontWeight.Bold),
}

Theme.Radius = {
	Small = UDim.new(0, 8),
	Medium = UDim.new(0, 12),
	Large = UDim.new(0, 16),
	Pill = UDim.new(1, 0),
}

Theme.Tween = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
Theme.TweenSlow = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

return Theme
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[-- Stacked notifications at the top of the screen.

local UI = require(script.Parent.UI)
local Theme = require(script.Parent.Theme)

local C, F = Theme.Colors, Theme.Fonts

local Toasts = {}

local container: Frame
local order = 0

local KINDS = {
	info = { icon = "ℹ", colour = C.Accent },
	success = { icon = "✓", colour = C.Success },
	warning = { icon = "!", colour = C.Warning },
	error = { icon = "✕", colour = C.Danger },
}

function Toasts.mount(gui: ScreenGui)
	container = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 72),
		Size = UDim2.new(0, 420, 1, -80),
		BackgroundTransparency = 1,
		ZIndex = 100,
		Parent = gui,
		Children = { UI.list(8, nil, { HorizontalAlignment = Enum.HorizontalAlignment.Center }) },
	})
end

function Toasts.show(text: string, kind: string?)
	if not container then
		return
	end
	local style = KINDS[kind or "info"] or KINDS.info
	order -= 1
	local scale = UI.new("UIScale", { Scale = 0.85 })
	local toast = UI.new("CanvasGroup", {
		Name = "Toast",
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.new(),
		BackgroundColor3 = C.Raised,
		GroupTransparency = 1,
		ZIndex = 100,
		LayoutOrder = order, -- newest on top
		Parent = container,
		Children = {
			UI.corner(Theme.Radius.Medium),
			UI.stroke(style.colour, 1, 0.4),
			UI.padding(10, 16, 10, 12),
			UI.list(10, Enum.FillDirection.Horizontal, { VerticalAlignment = Enum.VerticalAlignment.Center }),
			UI.new("UISizeConstraint", { MaxSize = Vector2.new(420, math.huge) }),
			scale,
			UI.new("TextLabel", {
				Text = style.icon,
				FontFace = F.Heavy,
				TextSize = 14,
				TextColor3 = C.Bg,
				BackgroundColor3 = style.colour,
				Size = UDim2.fromOffset(22, 22),
				Children = { UI.corner(Theme.Radius.Pill) },
			}),
			UI.text({
				Text = text,
				TextSize = 15,
				FontFace = F.Medium,
				AutomaticSize = Enum.AutomaticSize.XY,
				Size = UDim2.new(),
				TextWrapped = true,
				TextTruncate = Enum.TextTruncate.None,
				Children = { UI.new("UISizeConstraint", { MaxSize = Vector2.new(340, math.huge) }) },
			}),
		},
	})
	UI.tween(toast, { GroupTransparency = 0 })
	UI.tween(scale, { Scale = 1 }, Theme.TweenSlow)
	task.delay(3.6, function()
		UI.tween(toast, { GroupTransparency = 1 })
		task.wait(0.2)
		toast:Destroy()
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- A small declarative UI kit.
--
--   UI.new("Frame", { Size = ..., Children = { UI.corner(12), UI.text({ Text = "Hi" }) } })
--
-- Function values connect to the event of the same name (Activated = function() ... end).

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local C, F = Theme.Colors, Theme.Fonts

local UI = {}

function UI.new(className: string, props: { [any]: any }?): any
	local instance = Instance.new(className)
	local children, parent
	for key, value in (props or {}) :: { [any]: any } do
		if key == "Children" then
			children = value
		elseif key == "Parent" then
			parent = value
		elseif typeof(value) == "function" then
			(instance :: any)[key]:Connect(value)
		else
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UI.tween(instance: Instance, props: { [string]: any }, info: TweenInfo?)
	local tween = TweenService:Create(instance, info or Theme.Tween, props)
	tween:Play()
	return tween
end

function UI.corner(radius: UDim | number?): UICorner
	local value = if typeof(radius) == "number" then UDim.new(0, radius) else (radius or Theme.Radius.Medium)
	return UI.new("UICorner", { CornerRadius = value })
end

function UI.stroke(colour: Color3?, thickness: number?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Color = colour or C.Border,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.padding(top: number, right: number?, bottom: number?, left: number?): UIPadding
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right or top),
		PaddingBottom = UDim.new(0, bottom or top),
		PaddingLeft = UDim.new(0, left or right or top),
	})
end

function UI.list(gap: number?, direction: Enum.FillDirection?, props: { [string]: any }?): UIListLayout
	local layout = UI.new("UIListLayout", {
		Padding = UDim.new(0, gap or 8),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	for key, value in (props or {}) :: { [any]: any } do
		(layout :: any)[key] = value
	end
	return layout
end

function UI.text(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = F.Medium,
		TextColor3 = C.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 0, 20),
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults)
end

local STYLES = {
	primary = { bg = C.Accent, hover = C.AccentHover, text = Color3.new(1, 1, 1) },
	success = { bg = C.Success, hover = C.SuccessHover, text = Color3.fromRGB(8, 30, 18) },
	danger = { bg = C.Danger, hover = C.DangerHover, text = Color3.new(1, 1, 1) },
	secondary = { bg = C.Raised, hover = C.RaisedHover, text = C.Text, stroke = true },
	ghost = { bg = C.Panel, hover = C.Raised, text = C.Muted },
}

-- props: Text, Style, Size, Position, AnchorPoint, TextSize, LayoutOrder, Name, OnClick, Font
function UI.button(props: { [string]: any }): TextButton
	local style = STYLES[props.Style or "secondary"]
	local scale = UI.new("UIScale")
	local button = UI.new("TextButton", {
		Name = props.Name or "Button",
		Text = props.Text or "",
		FontFace = props.Font or F.Bold,
		TextSize = props.TextSize or 16,
		TextColor3 = style.text,
		BackgroundColor3 = style.bg,
		AutoButtonColor = false,
		Size = props.Size or UDim2.fromOffset(120, 40),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Children = {
			UI.corner(props.Radius or Theme.Radius.Small),
			scale,
			if style.stroke then UI.stroke() else nil,
		},
	})
	button:SetAttribute("Style", props.Style or "secondary")

	button.MouseEnter:Connect(function()
		if not button:GetAttribute("Disabled") then
			UI.tween(button, { BackgroundColor3 = style.hover })
		end
	end)
	button.MouseLeave:Connect(function()
		if not button:GetAttribute("Disabled") then
			UI.tween(button, { BackgroundColor3 = style.bg })
		end
		UI.tween(scale, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		if not button:GetAttribute("Disabled") then
			UI.tween(scale, { Scale = 0.96 }, TweenInfo.new(0.08))
		end
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(scale, { Scale = 1 })
	end)
	if props.OnClick then
		button.Activated:Connect(function()
			if not button:GetAttribute("Disabled") then
				props.OnClick(button)
			end
		end)
	end
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

function UI.setEnabled(button: TextButton, enabled: boolean)
	local style = STYLES[button:GetAttribute("Style") or "secondary"]
	button:SetAttribute("Disabled", not enabled)
	button.BackgroundColor3 = if enabled then style.bg else C.Raised
	button.TextColor3 = if enabled then style.text else C.Faint
end

function UI.input(props: { [string]: any }): TextBox
	local box = UI.new("TextBox", {
		Name = props.Name or "Input",
		Text = props.Text or "",
		PlaceholderText = props.Placeholder or "",
		PlaceholderColor3 = C.Faint,
		ClearTextOnFocus = false,
		FontFace = props.Font or F.Medium,
		TextSize = props.TextSize or 16,
		TextColor3 = C.Text,
		TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left,
		BackgroundColor3 = C.Raised,
		Size = props.Size or UDim2.new(1, 0, 0, 40),
		Position = props.Position or UDim2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		Children = { UI.corner(Theme.Radius.Small), UI.padding(0, 12) },
	})
	local stroke = UI.stroke()
	stroke.Parent = box
	box.Focused:Connect(function()
		UI.tween(stroke, { Color = C.Accent })
	end)
	box.FocusLost:Connect(function()
		UI.tween(stroke, { Color = C.Border })
	end)
	return box
end

function UI.pill(text: string, fg: Color3, bg: Color3, props: { [string]: any }?): Frame
	local pill = UI.new("Frame", {
		Name = "Pill",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 24),
		BackgroundColor3 = bg,
		Children = {
			UI.corner(Theme.Radius.Pill),
			UI.padding(0, 10),
			UI.text({
				Name = "Label",
				Text = text,
				TextSize = 13,
				FontFace = F.Bold,
				TextColor3 = fg,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromScale(0, 1),
				TextTruncate = Enum.TextTruncate.None,
			}),
		},
	})
	for key, value in (props or {}) :: { [any]: any } do
		(pill :: any)[key] = value
	end
	return pill
end

function UI.scroll(props: { [string]: any }): ScrollingFrame
	local defaults = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Border,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Size = UDim2.fromScale(1, 1),
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.new("ScrollingFrame", defaults)
end

-- Destroys the visible children of a container but keeps its layout objects.
function UI.clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function UI.card(props: { [string]: any }): Frame
	local defaults = {
		BackgroundColor3 = C.Raised,
		Size = UDim2.new(1, 0, 0, 80),
	}
	for key, value in props do
		if key ~= "Children" then
			defaults[key] = value
		end
	end
	local children = { UI.corner(Theme.Radius.Medium), UI.stroke() }
	for _, child in props.Children or {} do
		table.insert(children, child)
	end
	defaults.Children = children
	return UI.new("Frame", defaults)
end

-- A stat tile: small label above a big value.
function UI.stat(label: string, value: string, accent: Color3?, layoutOrder: number?): Frame
	return UI.card({
		Name = label,
		LayoutOrder = layoutOrder or 0,
		Size = UDim2.fromOffset(0, 86),
		Children = {
			UI.padding(14, 16),
			UI.text({ Text = label, TextSize = 14, TextColor3 = C.Muted, FontFace = F.Medium }),
			UI.text({
				Name = "Value",
				Text = value,
				TextSize = 28,
				FontFace = F.Heavy,
				TextColor3 = accent or C.Text,
				Position = UDim2.fromOffset(0, 24),
				Size = UDim2.new(1, 0, 0, 34),
			}),
		},
	})
end

-- Centred dialog on a dim backdrop. Returns the dialog body and a close function.
function UI.modal(parent: Instance, props: { [string]: any })
	local scale = UI.new("UIScale", { Scale = 0.92 })
	local backdrop = UI.new("TextButton", {
		Name = "Modal",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = C.Backdrop,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = parent,
	})
	-- A button, so clicks inside the dialog never fall through to the backdrop.
	local dialog = UI.new("TextButton", {
		Name = "Dialog",
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(props.Width or 420, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = props.Background or C.Panel,
		ZIndex = 51,
		Parent = backdrop,
		Children = {
			UI.corner(Theme.Radius.Large),
			UI.stroke(),
			UI.padding(props.Padding or 20),
			UI.list(12),
			UI.new("UISizeConstraint", { MaxSize = Vector2.new(math.huge, props.MaxHeight or 640) }),
			scale,
		},
	})
	if props.Title then
		UI.text({
			Name = "Title",
			Text = props.Title,
			TextSize = 22,
			FontFace = F.Heavy,
			Size = UDim2.new(1, 0, 0, 28),
			LayoutOrder = -100,
			ZIndex = 52,
			Parent = dialog,
		})
	end

	UI.tween(backdrop, { BackgroundTransparency = 0.35 })
	UI.tween(scale, { Scale = 1 }, Theme.TweenSlow)

	local closed = false
	local function close()
		if closed then
			return
		end
		closed = true
		UI.tween(backdrop, { BackgroundTransparency = 1 })
		UI.tween(scale, { Scale = 0.92 })
		task.delay(0.15, function()
			backdrop:Destroy()
		end)
		if props.OnClose then
			props.OnClose()
		end
	end
	if props.Dismissable ~= false then
		backdrop.Activated:Connect(close)
	end
	return dialog, close
end

return UI
]]></string>
