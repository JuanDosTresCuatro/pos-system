		Category = "Snacks",
		Price = 5,
		TaxRate = 20,
		Colour = rgb(170, 110, 60),
		Tool = "Cheezburger",
	},
	{
		Id = "taco",
		Name = "Taco",
		Category = "Snacks",
		Price = 3,
		TaxRate = 20,
		Colour = rgb(230, 190, 90),
		Tool = "Taco",
	},
	{
		Id = "icecream",
